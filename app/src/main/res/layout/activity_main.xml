<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- Keep this as the first child: MainActivity injects the Hub & Guide action here. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Focus Elite logo"
                android:src="@drawable/ic_focus_elite_logo" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.02"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="25sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/app_tagline"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hero card remains the stable anchor used by MainActivity and screen-time navigation. -->
        <LinearLayout
            android:id="@id/screenTimeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_card_hero"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="22dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.09"
                android:text="TODAY AT A GLANCE"
                android:textColor="@color/accent_purple"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/todays_screen_time"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
            <TextView
                android:id="@id/screenTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="--"
                android:textColor="@color/text_primary"
                android:textSize="42sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tap to inspect app-by-app usage  →"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@id/dailyTimeAuditCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="13dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center">
                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:contentDescription="Daily time notebook"
                    android:src="@drawable/ic_daily_notebook" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily Time Notebook"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@id/tvDailyAuditSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Log offline hours, track habits and reflect daily"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Open notebook"
                android:src="@drawable/ic_arrow_forward" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="FOCUS &amp; GROW"
            android:textColor="@color/accent_purple"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.10" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@id/practiceSessionLink"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_circle" android:gravity="center">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="Practice mode" android:src="@drawable/ic_target_practice" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:gravity="center" android:maxLines="2" android:text="Practice session" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="Train your focus" android:textColor="@color/text_secondary" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@id/activityLink"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_circle" android:gravity="center">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="Physical activity" android:src="@drawable/ic_activity_runner" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:gravity="center" android:maxLines="2" android:text="Activity" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="Movement &amp; logs" android:textColor="@color/text_secondary" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:letterSpacing="0.10" android:text="REVIEW &amp; INSIGHTS" android:textColor="@color/accent_purple" android:textSize="11sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" android:orientation="horizontal">
            <LinearLayout android:id="@id/auditSummaryLink" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_card" android:clickable="true" android:focusable="true" android:gravity="center_horizontal" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_circle" android:gravity="center"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="Audit summary" android:src="@drawable/ic_audit_chart" /></LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:gravity="center" android:maxLines="2" android:text="Daily review" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@id/insightsDashboardLink" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_card" android:clickable="true" android:focusable="true" android:gravity="center_horizontal" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_circle" android:gravity="center"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="Insights" android:src="@drawable/ic_insights_bulb" /></LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:gravity="center" android:maxLines="2" android:text="Insights" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:letterSpacing="0.10" android:text="TOOLS &amp; SETTINGS" android:textColor="@color/accent_purple" android:textSize="11sp" android:textStyle="bold" />
        <LinearLayout android:id="@id/pinWidgetLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/bg_card" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:padding="15dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="13dp" android:contentDescription="Widget studio" android:src="@drawable/ic_settings_gear" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Command Deck Widget" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Customize your home-screen controls" android:textColor="@color/text_secondary" android:textSize="12sp" /></LinearLayout>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Open widget studio" android:src="@drawable/ic_arrow_forward" />
        </LinearLayout>
        <LinearLayout android:id="@id/auditSettingsLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/bg_card" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:padding="15dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="13dp" android:contentDescription="Time categories" android:src="@drawable/ic_daily_notebook" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Time categories &amp; audit settings" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Open settings" android:src="@drawable/ic_arrow_forward" />
        </LinearLayout>
        <LinearLayout android:id="@id/websiteBlockLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/bg_card" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:padding="15dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="13dp" android:contentDescription="Website blocker" android:src="@drawable/ic_target_practice" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Website blocker" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Open website blocker" android:src="@drawable/ic_arrow_forward" />
        </LinearLayout>
        <LinearLayout android:id="@id/calendarLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/bg_card" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:padding="15dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="13dp" android:contentDescription="Calendar" android:src="@drawable/ic_daily_notebook" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Calendar &amp; exemptions" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Open calendar" android:src="@drawable/ic_arrow_forward" />
        </LinearLayout>
        <TextView android:id="@id/deactivateShieldLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/bg_card" android:clickable="true" android:focusable="true" android:padding="15dp" android:text="Deactivate / manage shield" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@id/backupRestoreLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" android:background="@drawable/bg_card" android:clickable="true" android:focusable="true" android:padding="15dp" android:text="Backup &amp; restore" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PROTECTION STATUS" android:textColor="@color/accent_purple" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.10" />
            <TextView android:id="@id/allPermissionsSetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="8dp" android:text="All permissions configured" android:textColor="@color/success_green" android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />
            <Button android:id="@id/usageAccessButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Grant usage access" />
            <Button android:id="@id/accessibilityButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Enable accessibility blocker" />
            <Button android:id="@id/btnDeviceAdmin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Device admin controls" />
            <Button android:id="@id/batteryOptButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Background / battery access" />
        </LinearLayout>

        <LinearLayout android:id="@id/suggestionCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="14dp" android:visibility="gone">
            <TextView android:id="@id/suggestionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="14sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:orientation="horizontal">
                <Button android:id="@id/suggestionDismissButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dismiss" />
                <Button android:id="@id/suggestionAcceptButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Apply" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="APP CONTROL" android:textColor="@color/accent_purple" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.10" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@id/appListView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
