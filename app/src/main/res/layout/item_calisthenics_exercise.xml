<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_exercise_thumb"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/ivThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Exercise preview" />

            <TextView
                android:id="@+id/tvThumbInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="P"
                android:textColor="@color/accent_purple"
                android:textSize="26sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <TextView
                    android:id="@+id/tvExerciseName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Push-Up"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvFavorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☆"
                    android:textSize="22sp"
                    android:textColor="#9AA3B2"
                    android:paddingStart="10dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="6dp"
                    android:contentDescription="Favourite" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvLevelBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Beginner"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#3DDC97"
                    android:background="@drawable/bg_button_pill"
                    android:backgroundTint="#1E3A30"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvEquipmentBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bodyweight"
                    android:textSize="10sp"
                    android:textColor="#00E5FF"
                    android:background="@drawable/bg_button_pill"
                    android:backgroundTint="#162E3B"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMetaLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Chest · Strength · Reps"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:id="@+id/layoutInstructionsToggle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvToggleInstructions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Demo &amp; steps"
                android:textSize="12sp"
                android:textColor="@color/accent_purple" />

            <TextView
                android:id="@+id/tvInstructionsChevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="▼"
                android:textSize="10sp"
                android:textColor="@color/accent_purple" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSelectExercise"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Add to workout ›"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_button_primary"
            android:textAllCaps="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </LinearLayout>

    <com.focusguardpro.app.calisthenics.ExerciseDemoView
        android:id="@+id/demoViewItem"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_marginTop="10dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvInstructionsBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="13sp"
        android:textColor="#C3CAD6"
        android:lineSpacingExtra="4dp"
        android:visibility="gone" />

</LinearLayout>
