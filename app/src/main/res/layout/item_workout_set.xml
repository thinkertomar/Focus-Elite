<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_tile"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="8dp"
    android:paddingEnd="6dp"
    android:paddingBottom="8dp">

    <!-- Set number badge (long-press to delete) -->
    <TextView
        android:id="@+id/tvSetNumber"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_button_pill"
        android:gravity="center"
        android:includeFontPadding="false"
        android:padding="0dp"
        android:text="1"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Previous performance chip (tap to copy into current set) -->
    <TextView
        android:id="@+id/tvPrevious"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:paddingVertical="4dp"
        android:text="—"
        android:textColor="#9AA3B2"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- Reps compact stepper (rebalanced widths so 1-3 digits never clip) -->
    <LinearLayout
        android:id="@+id/llRepsStepper"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginEnd="5dp"
        android:layout_weight="1"
        android:background="@drawable/bg_button_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="1dp"
        android:paddingEnd="1dp">

        <TextView
            android:id="@+id/btnRepsMinus"
            android:layout_width="22dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:includeFontPadding="false"
            android:padding="0dp"
            android:text="−"
            android:textColor="#8E87FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRepsValue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:imeOptions="actionDone"
            android:includeFontPadding="false"
            android:inputType="number"
            android:maxLength="3"
            android:minWidth="32dp"
            android:padding="0dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:text="10"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRepsPlus"
            android:layout_width="22dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:includeFontPadding="false"
            android:padding="0dp"
            android:text="+"
            android:textColor="#8E87FF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hold (seconds) compact stepper (rebalanced widths so 1-4 digits never clip) -->
    <LinearLayout
        android:id="@+id/llHoldStepper"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginEnd="5dp"
        android:layout_weight="1"
        android:background="@drawable/bg_button_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="1dp"
        android:paddingEnd="1dp">

        <TextView
            android:id="@+id/btnHoldMinus"
            android:layout_width="22dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:includeFontPadding="false"
            android:padding="0dp"
            android:text="−"
            android:textColor="#4FD1FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etHoldValue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:imeOptions="actionDone"
            android:includeFontPadding="false"
            android:inputType="number"
            android:maxLength="4"
            android:minWidth="32dp"
            android:padding="0dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnHoldPlus"
            android:layout_width="22dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:includeFontPadding="false"
            android:padding="0dp"
            android:text="+"
            android:textColor="#4FD1FF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Done check toggle -->
    <TextView
        android:id="@+id/btnCheckSet"
        android:layout_width="34dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_button_pill"
        android:gravity="center"
        android:includeFontPadding="false"
        android:padding="0dp"
        android:text="✓"
        android:textColor="#9AA3B2"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
