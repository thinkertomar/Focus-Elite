<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutSetRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_tile"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_marginBottom="6dp">

    <TextView
        android:id="@+id/tvSetNumber"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:text="1"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_button_pill"
        android:backgroundTint="#262D3D"
        android:layout_marginEnd="6dp" />

    <TextView
        android:id="@+id/tvPrevious"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        android:text="—"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginEnd="6dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_button_pill"
        android:backgroundTint="#0E1320"
        android:layout_marginEnd="6dp">

        <ImageButton
            android:id="@+id/btnRepsMinus"
            android:layout_width="26dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_remove"
            android:tint="@color/text_secondary"
            android:contentDescription="Decrease reps" />

        <EditText
            android:id="@+id/etRepsValue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="15"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="3"
            android:padding="0dp"
            android:background="@android:color/transparent"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/btnRepsPlus"
            android:layout_width="26dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add"
            android:tint="@color/text_secondary"
            android:contentDescription="Increase reps" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_button_pill"
        android:backgroundTint="#0E1320"
        android:layout_marginEnd="6dp">

        <ImageButton
            android:id="@+id/btnHoldMinus"
            android:layout_width="26dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_remove"
            android:tint="@color/text_secondary"
            android:contentDescription="Decrease hold" />

        <EditText
            android:id="@+id/etHoldValue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="0"
            android:hint="0"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#00E5FF"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="3"
            android:padding="0dp"
            android:background="@android:color/transparent"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/btnHoldPlus"
            android:layout_width="26dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add"
            android:tint="@color/text_secondary"
            android:contentDescription="Increase hold" />
    </LinearLayout>

    <Button
        android:id="@+id/btnCheckSet"
        android:layout_width="38dp"
        android:layout_height="36dp"
        android:text="✓"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:background="@drawable/bg_button_pill"
        android:backgroundTint="#1F2533"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp" />

</LinearLayout>
